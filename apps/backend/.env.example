PORT=5000
NODE_ENV=development

# Database connection URL (MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/university_budget_db"

# JWT Configuration
# Use a cryptographically random secret of at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="1d"
JWT_ISSUER="budgetchain-api"
JWT_AUDIENCE="budgetchain-web"

# Security & CORS
CORS_ORIGIN="*"

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
SENSITIVE_RATE_LIMIT_WINDOW_MS=3600000
SENSITIVE_RATE_LIMIT_MAX=10
# Stricter per-IP cap for multipart document uploads (Phase 4.5).
UPLOAD_RATE_LIMIT_WINDOW_MS=900000
UPLOAD_RATE_LIMIT_MAX=20

# Blockchain / EVM Configuration (Phase 4.4)
# Leave unset to report "not configured" and keep the app fully usable without a node.
# For local development: start `npm run blockchain:node` and `npm run blockchain:deploy`.
BLOCKCHAIN_RPC_URL="http://127.0.0.1:8545"
BLOCKCHAIN_NETWORK="hardhat-local"
BLOCKCHAIN_CHAIN_ID=31337
# Optional: defaults to the address written by the deploy script to
# apps/contracts/deployments/contracts.json
# BLOCKCHAIN_CONTRACT_ADDRESS="0x..."
# Signing key for submitting ledger transactions (Hardhat local account #0).
# BLOCKCHAIN_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"

# Document Management (Phase 4.5)
# Storage driver: "local" (filesystem) or "s3" (not yet implemented).
STORAGE_DRIVER="local"
# Root directory for stored document bytes. Relative paths resolve against
# apps/backend. The upload layer never uses client file names in paths.
STORAGE_ROOT="storage/documents"
# Maximum accepted file size in bytes (default 25 MB).
MAX_FILE_SIZE_BYTES=26214400
# Maximum number of versions allowed per document (default 50).
MAX_DOCUMENT_VERSIONS=50

# Audit Log Persistence (Phase 4.6 M1)
# When true, every auditLogger.log() call is persisted to the append-only
# `audit_logs` table (fire-and-forget, never throws). Set to false to keep the
# logger console-only (e.g. for tests or throwaway environments).
AUDIT_LOG_DB_ENABLED=true
