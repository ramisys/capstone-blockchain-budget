{
  "name": "capstone",
  "private": true,
  "workspaces": [
    "apps/backend",
    "apps/frontend",
    "apps/contracts",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "backend": "npm run start --workspace=apps/backend",
    "frontend": "npm run dev --workspace=apps/frontend",
    "test:backend": "npm run test --workspace=apps/backend",
    "test:frontend": "npm run test --workspace=apps/frontend",
    "test": "npm run test:backend && npm run test:frontend",
    "build:frontend": "npm run build --workspace=apps/frontend",
    "blockchain:compile": "npm run compile --workspace=apps/contracts",
    "blockchain:node": "npm run node --workspace=apps/contracts",
    "blockchain:deploy": "npx hardhat run apps/contracts/scripts/deploy.js --config apps/contracts/hardhat.config.js --network localhost"
  }
}
